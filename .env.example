# Optional overrides — acronis-mcp has no required env vars.
# Authentication is per-request via two headers:
#   X-Acronis-Token          bearer access token (OAuth2 Client Credentials grant,
#                            POST <datacenter-url>/api/2/idp/token with client_id +
#                            client_secret). This server never sees the client_id/
#                            client_secret — the caller (Agent Platform / upstream
#                            gateway) obtains and refreshes the token, and only the
#                            resulting bearer token is forwarded here.
#   X-Acronis-Datacenter-Url the Acronis data center base URL for this tenant,
#                            e.g. https://us5-cloud.acronis.com

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
